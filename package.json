{
  "name": "@ansango/lastfm-cli",
  "version": "0.9.0",
  "description": "CLI for the Last.fm API, built on @ansango/lastfm-api. Read-only by default — no auth required.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lastfm": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-banner.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "node --test --import tsx tests/*.test.ts tests/insights/lib/*.test.ts tests/insights/integration/*.test.ts",
    "test:watch": "node --test --import tsx --watch tests/*.test.ts tests/insights/lib/*.test.ts tests/insights/integration/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ansango/lastfm-api": "^3.7.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "lastfm",
    "cli",
    "music",
    "api"
  ],
  "author": "ansango <anibalsantosgo@gmail.com>",
  "homepage": "https://github.com/ansango/lastfm-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansango/lastfm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ansango/lastfm-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
