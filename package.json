{
  "name": "lastfm-cli",
  "version": "0.1.0",
  "description": "CLI for the Last.fm API, built on lastfm-client-ts. Read-only by default — no auth required.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lastfm": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-banner.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:watch": "node --test --import tsx --watch tests/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "lastfm-client-ts": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "lastfm",
    "cli",
    "music",
    "api"
  ],
  "publishConfig": {
    "access": "public"
  }
}